# Настройки для dev-сборки на сервер (npm run build:dev:remote / start:dev:remote).
# Используются ТОЛЬКО в development-режиме (не standalone). Production-сборка всегда идёт в dist/.
#
# Скопируйте этот файл в .env и замените значения на актуальные.
# .env добавлен в .gitignore — настройки останутся локальными.

# Путь к папке AppliedModules на сервере стенда
SUNGERO_DEPLOY_BASE=<путь до директории со сторонними компонентами на сервере>

# Имя прикладного решения (SolutionName из Dev Studio)
SUNGERO_SOLUTION_NAME=Sungero.MySolution

# Имя папки компонента в решении
SUNGERO_COMPONENT_NAME=DemoComponent

# Итоговый путь сборки:
# {SUNGERO_DEPLOY_BASE}/{SOLUTION_NAME}.Components/{COMPONENT_NAME}
