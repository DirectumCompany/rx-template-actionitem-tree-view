{
  "name": "react-remote-component-example",
  "author": "Directum",
  "license": "MIT",
  "version": "1.0.0",
  "description": "Example of remote component for DirectumRX.",
  "private": true,
  "main": "index.js",
  "scripts": {
    "build:release": "webpack --mode production --progress=profile",
    "build:dev:standalone": "webpack --mode development --progress=profile --env mode=standalone",
    "build:dev:remote": "webpack --mode development --progress=profile",
    "serve": "serve dist -p 3001",
    "start:dev:standalone": "concurrently \"webpack --mode development --progress=profile --env mode=standalone --watch\" \"npm run serve\"",
    "start:dev:remote": "webpack --mode development --progress=profile --watch",
    "prettier:fix": "npx prettier . --write",
    "prettier:check": "npx prettier . --check",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run build:dev:remote",
    "check:full": "npm run prettier:check && npm run typecheck && npm run lint && npm run build:release",
    "format": "npm run prettier:fix && npm run lint:fix"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-react": "^7.25.9",
    "@babel/preset-typescript": "^7.25.9",
    "@directum/sungero-remote-component-metadata-plugin": "1.0.1",
    "@directum/sungero-remote-component-types": "1.0.1",
    "@eslint/js": "^9.39.5",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^20.19.0",
    "@types/react": "18.2.21",
    "@types/react-dom": "18.2.7",
    "babel-loader": "^10.1.0",
    "concurrently": "8.2.1",
    "css-loader": "^7.1.0",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-check-file": "^2.8.0",
    "eslint-plugin-css-modules": "^2.12.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-unicorn": "^48.0.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "html-webpack-plugin": "5.5.1",
    "mini-css-extract-plugin": "2.7.6",
    "prettier": "^3.9.3",
    "serve": "^14.2.6",
    "style-loader": "3.3.2",
    "terser-webpack-plugin": "^5.6.1",
    "ts-node": "^10.9.2",
    "typescript": "~5.4.0",
    "typescript-eslint": "^8.65.0",
    "webpack": "~5.108.0",
    "webpack-cli": "~5.1.4"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "gantt-task-react": "0.3.9",
    "i18next": "23.11.5",
    "i18next-browser-languagedetector": "8.0.0",
    "i18next-http-backend": "^3.0.6",
    "react": "18.2.0",
    "react-d3-tree": "^3.6.6",
    "react-data-grid": "7.0.0-beta.37",
    "react-dom": "18.2.0",
    "react-error-boundary": "^4.1.2",
    "react-i18next": "11.18.6"
  }
}
